# NotebookFlow Root Environment Variables Reference

# --- Backend Configuration (Cloud Run) ---
ENVIRONMENT=production
SESSION_SECRET_KEY=generate-a-random-32-byte-hex-string
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-cloud-run-service.a.run.app/api/drive/callback
FRONTEND_URL=https://your-vercel-domain.vercel.app
CORS_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:5173
CONVERSION_TIMEOUT_SECONDS=60
MAX_CONCURRENT_CONVERSIONS=4

# --- Frontend Configuration (Vercel) ---
VITE_API_BASE_URL=https://your-cloud-run-service.a.run.app

